{
  "manifest_version": 3,
  "name": "MD抓吗",
  "version": "1.4.0",
  "description": "一键深度抓取网页所有正文、图片与复杂排版并转换为标准Markdown，无缝保存至Obsidian。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "downloads",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "quick-clip-silent": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "快捷静默剪藏当前页面至 Obsidian"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "utils/logger.js",
        "utils/sync-queue.js",
        "lib/turndown.js",
        "lib/turndown-plugin-gfm.js",
        "lib/readability.js",
        "content/cleaner.js",
        "content/pipeline/transformers.js",
        "content/pipeline/parser-engine.js",
        "content/scroller.js",
        "content/adapters/utils.js",
        "content/adapters/generic.js",
        "content/adapters/feishu.js",
        "content/adapters/shengcai.js",
        "content/adapters/wechat.js",
        "content/adapters/zhihu.js",
        "content/adapters/yuque.js",
        "content/adapters/notion.js",
        "content/adapters/juejin.js",
        "content/extractor.js",
        "content/ui/bubble.js",
        "content/index.js"
      ],
      "css": [
        "content/ui/bubble.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
